{
  "name": "jarvis-local-desktop", "productName": "Jarvis", "version": "3.3.0-rc.2", "private": true,
  "description": "Conversation privée avec un modèle exécuté sur cet ordinateur.",
  "author": "Raphaël Flipo", "license": "MIT", "main": "main.cjs",
  "devDependencies": { "electron": "45.3.1", "electron-builder": "26.18.0" },
  "scripts": { "start": "electron .", "dist": "electron-builder --win nsis --x64" },
  "build": {
    "appId": "io.github.raphaelflipo.jarvis", "productName": "Jarvis",
    "artifactName": "Jarvis-${version}-Windows-x64-Setup.${ext}",
    "files": ["main.cjs", "selftest.js", "ui-selftest.js", "app/**/*", "package.json"],
    "win": { "target": "nsis", "icon": "icon.ico", "signAndEditExecutable": true },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "deleteAppDataOnUninstall": false }
  }
}
